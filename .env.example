# CaseFinder Environment Variables
# Copy this to .env and fill in your values

# Required — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — apply at https://www.canlii.org/en/tools/api.html
CANLII_API_KEY=

# Optional — set to "on" to ground /api/analyze in the full CDSA and YCJA data.
# Leave unset until scripts/evaluate-statute-grounding.mjs has been run live
# and read; see docs/statute-grounding.md.
STATUTE_GROUNDING=
