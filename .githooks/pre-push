#!/usr/bin/env bash
set -euo pipefail

# Pre-push gate: run the unit suite and block the push if it fails. A
# rate-limit-bypass regression and a prompt-injection blocklist bug once shipped
# with their unit tests already red because nothing ran them before push.
# CI's unit-component-build job repeats this on every PR.
#
# Escape hatch (use sparingly, e.g. docs-only pushes): git push --no-verify

echo "pre-push: running unit tests (npm run test:unit)..."

if ! npm run --silent test:unit; then
  echo "" >&2
  echo "pre-push: BLOCKED — unit tests failed. Fix them before pushing." >&2
  echo "pre-push: (to bypass for a non-code push: git push --no-verify)" >&2
  exit 1
fi

echo "pre-push: unit tests passed."
