#!/usr/bin/env bash
set -euo pipefail

# Pre-push gate: run the unit suite and block the push if it fails. A
# rate-limit-bypass regression and a prompt-injection blocklist bug once shipped
# with their unit tests already red because nothing ran them before push.
# CI's unit-component-build job repeats this on every PR.
#
# Skipped automatically when every pushed commit only touches docs/reports/
# artifacts. Escape hatch for anything else: git push --no-verify

# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
code_changed=0
while read -r _ local_sha _ remote_sha; do
  # Deleting a remote ref: nothing to test.
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    range="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha~1")..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  # If the diff can't be computed, assume code changed and run the tests.
  if ! files="$(git diff --name-only "$range" 2>/dev/null)" \
    || printf '%s\n' "$files" | grep -qvE '\.md$|^docs/|^reports/|^artifacts/'; then
    code_changed=1
  fi
done

if [ "$code_changed" -eq 0 ]; then
  echo "pre-push: docs-only push, skipping tests."
  exit 0
fi

echo "pre-push: running unit tests (npm run test:unit)..."

if ! npm run --silent test:unit; then
  echo "" >&2
  echo "pre-push: BLOCKED — unit tests failed. Fix them before pushing." >&2
  echo "pre-push: (to bypass: git push --no-verify)" >&2
  exit 1
fi

echo "pre-push: unit tests passed."
